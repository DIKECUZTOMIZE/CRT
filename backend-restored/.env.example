PORT=3000
NODE_ENV="development"

# Use your MongoDB Atlas connection string here.
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/CRT"
# For local host-only execution, use redis://localhost:6379.
# For Docker Compose backend + Redis, use the Redis service name.
REDIS_URL="redis://redis:6379"

CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"
FRONTEND_URL="http://localhost:5173"
ADMIN_FRONTEND_URL="http://localhost:5174"
ORGANIZER_FRONTEND_URL="http://localhost:5175"

ACCESS_TOKEN_SECRET="replace-with-a-strong-random-secret"
REFRESH_TOKEN_SECRET="replace-with-a-strong-random-secret"
ADMIN_REGISTRATION_KEY="replace-with-admin-registration-key"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

LOGGER_LEVEL="info"
RATELIMIT_WINDOW_MS=900000
RATELIMIT=100

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-gmail-app-password"
SMTP_FROM="your-email@gmail.com"
